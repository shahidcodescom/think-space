# Bi-Polar — copy to .env and fill in values (never commit .env)

# Required in production for encrypted secrets / stored API keys
SECRETS_MASTER_KEY=

# Session cookie HMAC (falls back to SECRETS_MASTER_KEY, then a local dev default)
SESSION_SECRET=

# Force Secure cookies (default: on when NODE_ENV=production or HTTPS)
# COOKIE_SECURE=true

# App
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Optional LLM (env fallback; Profile UI can also store an encrypted key)
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional Postgres + pgvector (compose service `db` when using --profile pgvector)
DATABASE_URL=postgresql://bipolar:bipolar@db:5432/bipolar
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=bipolar
DATABASE_USER=bipolar
DATABASE_PASSWORD=bipolar
DATABASE_SSL=false
